---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const updates = (await getCollection('updates')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Updates">
	<h1>Updates</h1>
	{
		updates.length === 0 ? (
			<p>No updates yet.</p>
		) : (
			<ul class="update-list">
				{updates.map((update) => (
					<li class="panel">
						<a href={`/updates/${update.id}`}>{update.data.title}</a>
						<time datetime={update.data.date.toISOString()}>
							{update.data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
						</time>
						{update.data.summary && <p>{update.data.summary}</p>}
					</li>
				))}
			</ul>
		)
	}
</Layout>

<style>
	.update-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.update-list a {
		font-family: var(--font-display);
		font-size: 1.15rem;
	}
	.update-list time {
		display: block;
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin-top: 0.2rem;
	}
	.update-list p {
		color: var(--color-text-muted);
		margin: 0.6rem 0 0;
	}
</style>
