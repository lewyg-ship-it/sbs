---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const updates = (await getCollection('updates')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Updates">
	<h1>Updates</h1>
	{
		updates.length === 0 ? (
			<p>No updates yet.</p>
		) : (
			<ul class="update-list">
				{updates.map((update) => (
					<li>
						<a href={`/updates/${update.id}`}>{update.data.title}</a>
						<time datetime={update.data.date.toISOString()}>
							{update.data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
						</time>
						{update.data.summary && <p>{update.data.summary}</p>}
					</li>
				))}
			</ul>
		)
	}
</Layout>

<style>
	.update-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.update-list li {
		border-bottom: 1px solid #2a2f36;
		padding-bottom: 1rem;
	}
	.update-list a {
		font-size: 1.1rem;
		font-weight: 600;
	}
	.update-list time {
		display: block;
		color: #7a828c;
		font-size: 0.9rem;
		margin-top: 0.15rem;
	}
	.update-list p {
		color: #c2c7cd;
		margin: 0.5rem 0 0;
	}
</style>
