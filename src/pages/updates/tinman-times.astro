---
import Layout from '../../layouts/Layout.astro';
import TimezoneSelector from '../../components/TimezoneSelector.astro';
import { getCollection, render } from 'astro:content';

const updates = await getCollection('updates');
const update = updates.find((entry) => entry.id === 'tinman-times');
const { Content } = await render(update);
---

<Layout title={update.data.title}>
	<article>
		<h1>{update.data.title}</h1>
		<time datetime={update.data.date.toISOString()}>
			{update.data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
		</time>
		<div class="content">
			<Content />
		</div>
		<TimezoneSelector />
	</article>
</Layout>

<style>
	time {
		display: block;
		font-family: var(--font-display);
		color: var(--color-gold);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		margin: 0.25rem 0 1.5rem;
	}
	.content {
		line-height: 1.7;
		color: var(--color-text-muted);
	}
</style>
