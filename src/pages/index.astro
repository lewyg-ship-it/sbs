---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site-config';
import { getCollection } from 'astro:content';

const updates = (await getCollection('updates'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<Layout>
	<section class="hero">
		<h1>{siteConfig.name}</h1>
		<p class="tagline">{siteConfig.tagline}</p>
	</section>

	<section>
		<h2>Latest Updates</h2>
		{
			updates.length === 0 ? (
				<p>No updates yet.</p>
			) : (
				<ul class="update-list">
					{updates.map((update) => (
						<li class="panel">
							<a href={`/updates/${update.id}`}>{update.data.title}</a>
							<time datetime={update.data.date.toISOString()}>
								{update.data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						</li>
					))}
				</ul>
			)
		}
		<a class="see-all" href="/updates">See all updates &rarr;</a>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 1rem 0 3rem;
	}
	.hero h1 {
		font-size: 2.5rem;
	}
	.tagline {
		font-style: italic;
		color: var(--color-text-muted);
		max-width: 32rem;
		margin: 0 auto;
	}
	.update-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.update-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
	}
	.update-list a {
		font-family: var(--font-display);
		font-size: 1.05rem;
	}
	.update-list time {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.see-all {
		display: inline-block;
		margin-top: 1.25rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
	}
</style>
