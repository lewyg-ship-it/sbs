---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site-config';
import { getCollection } from 'astro:content';

const updates = (await getCollection('updates'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<Layout>
	<section class="hero">
		<h1>{siteConfig.name}</h1>
		<p>{siteConfig.tagline}</p>
	</section>

	<section>
		<h2>Latest updates</h2>
		{
			updates.length === 0 ? (
				<p>No updates yet.</p>
			) : (
				<ul class="update-list">
					{updates.map((update) => (
						<li>
							<a href={`/updates/${update.id}`}>{update.data.title}</a>
							<time datetime={update.data.date.toISOString()}>
								{update.data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						</li>
					))}
				</ul>
			)
		}
		<a href="/updates">See all updates &rarr;</a>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 2rem 0 3rem;
	}
	.hero p {
		color: #a7adb4;
	}
	.update-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.update-list li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid #2a2f36;
		padding-bottom: 0.75rem;
	}
	.update-list time {
		color: #7a828c;
		font-size: 0.9rem;
		white-space: nowrap;
	}
</style>
